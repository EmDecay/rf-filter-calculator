import npyscreen

class MyTestForm(npyscreen.ActionForm):
    def create(self):
        self.add(npyscreen.TitleFixedText, name="NpyScreen Multi-Field Form Example", editable=False)
        self.add(npyscreen.FixedText, value="Fill out the form below. Use Tab/Shift+Tab to navigate.", editable=False)
        self.add(npyscreen.FixedText, value="Press Ctrl+X to exit without saving.", editable=False)
        self.add(npyscreen.FixedText, value="", editable=False) # Spacer

        self.name_input = self.add(npyscreen.TitleText, name="Your Name:", value="", help="Enter your full name.")
        self.email_input = self.add(npyscreen.TitleText, name="Email:", value="", help="Enter a valid email address.")
        self.password_input = self.add(npyscreen.TitlePassword, name="Password:", value="", help="Enter a password (min 6 chars).")

        self.gender_select = self.add(npyscreen.TitleSelectOne,
                                      name="Gender:",
                                      values=["Male", "Female", "Other", "Prefer not to say"],
                                      value=[0], # Default to Male
                                      max_height=4,
                                      scroll_exit=True,
                                      help="Select your gender.")

        self.interests_multiselect = self.add(npyscreen.TitleMultiSelect,
                                              name="Interests:",
                                              values=["Programming", "Reading", "Sports", "Music", "Travel"],
                                              value=[0, 2], # Default to Programming and Sports
                                              max_height=5,
                                              scroll_exit=True,
                                              help="Select your interests (multiple allowed).")

        self.subscribe_checkbox = self.add(npyscreen.CheckBox, name="Subscribe to Newsletter?", value=True, help="Check to subscribe.")

        self.birth_date = self.add(npyscreen.TitleDate, name="Date of Birth:", help="Enter your date of birth.")

        # Add a button to explicitly trigger validation and show results
        self.add(npyscreen.ButtonPress, name="Submit Form", when_pressed_function=self.on_ok)

    def beforeEditing(self):
        # This method is called before the form is displayed and edited.
        # You can set initial values or perform setup here.
        pass

    def on_ok(self):
        # This method is called when the user presses the "OK" button or equivalent.
        # Perform validation here.
        errors = []

        # Name validation
        if not self.name_input.value.strip():
            errors.append("Name cannot be empty.")

        # Email validation (simple check)
        if "@" not in self.email_input.value or "." not in self.email_input.value:
            errors.append("Please enter a valid email address.")

        # Password validation
        if len(self.password_input.value) < 6:
            errors.append("Password must be at least 6 characters long.")

        # Gender selection validation
        if not self.gender_select.value:
            errors.append("Please select your gender.")

        # Interests validation (optional, just an example)
        if not self.interests_multiselect.value:
            errors.append("Please select at least one interest.")

        if errors:
            npyscreen.notify_confirm("\n".join(errors), title="Validation Errors", wrap=True)
            return False # Prevent form from closing
        else:
            # If validation passes, display the collected data
            results = [
                f"Name: {self.name_input.value}",
                f"Email: {self.email_input.value}",
                f"Password (hidden): {'*' * len(self.password_input.value)}",
                f"Gender: {self.gender_select.values[self.gender_select.value[0]] if self.gender_select.value else 'N/A'}",
                f"Interests: {', '.join([self.interests_multiselect.values[i] for i in self.interests_multiselect.value])}",
                f"Subscribe to Newsletter: {'Yes' if self.subscribe_checkbox.value else 'No'}",
                f"Date of Birth: {self.birth_date.value.strftime('%Y-%m-%d') if self.birth_date.value else 'N/A'}"
            ]
            npyscreen.notify_confirm("\n".join(results), title="Form Submitted Successfully!", wrap=True)
            self.parentApp.setNextForm(None) # Exit the application
            return True

    def on_cancel(self):
        # This method is called when the user presses the "Cancel" button or equivalent (e.g., Ctrl+X).
        npyscreen.notify_confirm("Form submission cancelled.", title="Cancelled")
        self.parentApp.setNextForm(None) # Exit the application
        return True

class MyTestApp(npyscreen.NPSAppManaged):
    def onStart(self):
        self.addForm("MAIN", MyTestForm, name="NpyScreen Example Form")

if __name__ == "__main__":
    # Ensure the terminal is large enough for the form
    # npyscreen.wrapper_basic(MyTestApp().run) # Use this for simpler apps without NPSAppManaged
    try:
        TA = MyTestApp()
        TA.run()
    except Exception as e:
        print(f"An error occurred: {e}")
        print("Please ensure your terminal is large enough and try again.")
        print("You might need to install npyscreen: pip install npyscreen")
