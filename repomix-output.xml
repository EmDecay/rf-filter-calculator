from textual.app import App, ComposeResult
from textual.widgets import Input, Checkbox, Button, RadioSet, RadioButton, Header, Footer
from textual.containers import Container
from textual.validation import Validator, ValidationResult

class UsernameValidator(Validator):
    def validate(self, value: str) -> ValidationResult:
        if len(value) < 3:
            return self.failure("Username must be at least 3 characters long")
        if not value.isalnum():
            return self.failure("Username must be alphanumeric")
        return self.success()

class TextualFormApp(App):
    BINDINGS = [
        ("d", "toggle_dark", "Toggle dark mode"),
        ("s", "submit", "Submit Form"),
    ]

    def compose(self) -> ComposeResult:
        yield Header()
        with Container():
            yield Input(placeholder="Enter username", validators=[UsernameValidator()], id="username_input")
            yield RadioSet(
                RadioButton("Red", value="red"),
                RadioButton("Green", value="green"),
                RadioButton("Blue", value="blue", id="blue_radio"),
                id="color_select",
            )
            yield Checkbox("Subscribe to newsletter", id="newsletter_checkbox")
            yield Button("Submit", variant="primary", id="submit_button")
        yield Footer()

    def on_button_pressed(self, event: Button.Pressed) -> None:
        if event.button.id == "submit_button":
            self.action_submit()

    def action_submit(self) -> None:
        username_input = self.query_one("#username_input", Input)
        color_select = self.query_one("#color_select", RadioSet)
        newsletter_checkbox = self.query_one("#newsletter_checkbox", Checkbox)

        if username_input.validate().is_valid:
            username = username_input.value
            color = color_select.pressed_button.value if color_select.pressed_button else "No color selected"
            newsletter = newsletter_checkbox.value
            self.notify(f"Username: {username}, Color: {color}, Newsletter: {newsletter}")
            self.app.exit((username, color, newsletter))
        else:
            self.notify("Please correct the form errors.")

    def action_toggle_dark(self) -> None:
        self.dark = not self.dark

if __name__ == "__main__":
    app = TextualFormApp()
    app.run()
