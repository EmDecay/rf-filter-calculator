from prompt_toolkit import Application
from prompt_toolkit.layout.containers import VSplit, Window, HSplit
from prompt_toolkit.layout.controls import BufferControl, FormattedTextControl
from prompt_toolkit.buffer import Buffer
from prompt_toolkit.layout.layout import Layout
from prompt_toolkit.key_binding import KeyBindings
from prompt_toolkit.validation import Validator, ValidationError
from prompt_toolkit.widgets import TextArea, Button, CheckboxList, RadioList
from prompt_toolkit.styles import Style
from prompt_toolkit.layout.dimension import Dimension as D

# 1. Define Custom Validators
class RequiredValidator(Validator):
    """Validator to ensure a field is not empty."""
    def validate(self, document):
        if not document.text.strip():
            raise ValidationError(message="This field is required.", cursor_position=0)

class NumberValidator(Validator):
    """Validator to ensure input is a valid number."""
    def validate(self, document):
        if document.text and not document.text.isdigit():
            raise ValidationError(message="Please enter a number.", cursor_position=len(document.text))

# 2. Wrapper class for form fields to manage label, control, validator, and error display
class FormField:
    def __init__(self, label, control, validator=None, name=None):
        self.label = label
        self.control = control
        self.validator = validator
        self.name = name or label.lower().replace(" ", "_")
        self.error_message_control = FormattedTextControl(text="")
        self.is_valid = True

    def get_container(self):
        """Returns an HSplit container for the field, its label, and error message."""
        return HSplit([
            Window(content=FormattedTextControl(text=self.label + ":", style="class:label"), height=D(min=1, max=1), dont_extend_width=True),
            Window(content=self.control, height=D(min=1, max=1), style="class:text-area"),
            Window(content=self.error_message_control, height=D(min=1, max=1), style="class:error")
        ])

    def validate(self):
        """Performs validation on the field's current value."""
        try:
            if self.validator:
                # For TextArea, validate the buffer's document.
                # For RadioList/CheckboxList, validate their current_value.
                if isinstance(self.control, TextArea):
                    self.validator.validate(self.control.buffer.document)
                elif isinstance(self.control, (RadioList, CheckboxList)):
                    # Create a dummy document for validation of non-buffer controls
                    # This assumes validators check `document.text`
                    dummy_document = type('Document', (object,), {'text': str(self.control.current_value)})()
                    self.validator.validate(dummy_document)
            self.error_message_control.text = ""
            self.is_valid = True
            return True
        except ValidationError as e:
            self.error_message_control.text = str(e)
            self.is_valid = False
            return False

    def get_value(self):
        """Retrieves the current value of the field."""
        if isinstance(self.control, TextArea):
            return self.control.text
        elif isinstance(self.control, CheckboxList):
            return self.control.current_values
        elif isinstance(self.control, RadioList):
            return self.control.current_value
        return None

# 3. Main Application Class
class MultiFieldForm:
    def __init__(self):
        self.fields = []
        self.focused_field_index = 0

        # Text Input Field: Name (Required)
        self.name_field = FormField(
            "Name",
            TextArea(multiline=False, wrap_lines=False),
            validator=RequiredValidator(),
            name="name"
        )
        self.fields.append(self.name_field)

        # Text Input Field: Age (Number only)
        self.age_field = FormField(
            "Age",
            TextArea(multiline=False, wrap_lines=False),
            validator=NumberValidator(),
            name="age"
        )
        self.fields.append(self.age_field)

        # Select Field: Gender (RadioList for single selection, Required)
        self.gender_field = FormField(
            "Gender",
            RadioList([("male", "Male"), ("female", "Female"), ("other", "Other")]),
            validator=RequiredValidator(),
            name="gender"
        )
        self.fields.append(self.gender_field)

        # Checkbox Field: Interests (Multiple selection)
        self.interests_field = FormField(
            "Interests",
            CheckboxList([("coding", "Coding"), ("reading", "Reading"), ("sports", "Sports"), ("music", "Music")]),
            name="interests"
        )
        self.fields.append(self.interests_field)

        # Submit Button
        self.submit_button = Button("Submit", handler=self._submit)
        self.submit_message_control = FormattedTextControl(text="")

        # Assemble the layout
        self.root_container = HSplit([
            Window(content=FormattedTextControl(text=" Multi-Field Form Example ", style="class:title"), height=D(min=1, max=1)),
            Window(height=1, char='─', style="class:line"),
            HSplit([field.get_container() for field in self.fields], padding=1),
            Window(height=1, char='─', style="class:line"),
            Window(content=self.submit_button, height=D(min=1, max=1), dont_extend_width=True, align="center"),
            Window(content=self.submit_message_control, height=D(min=1, max=1), style="class:message", align="center")
        ])

        # Setup key bindings for navigation and exit
        self.kb = KeyBindings()
        self._setup_key_bindings()

        # Initialize the application
        self.application = Application(
            layout=Layout(self.root_container, focused_element=self.fields[0].control),
            key_bindings=self.kb,
            full_screen=True,
            style=self._get_style()
        )

    def _get_style(self):
        """Defines the styling for the application."""
        return Style([
            ('title', 'bg:#005f87 #ffffff bold'),
            ('label', 'fg:#87afaf bold'),
            ('error', 'fg:#ff0000 bold'),
            ('message', 'fg:#00ff00 bold'),
            ('line', 'fg:#444444'),
            ('button', 'bg:#005f87 #ffffff'),
            ('button.focused', 'bg:#0087af #ffffff bold'),
            ('radio-list', 'fg:#ffffff'),
            ('radio-list.focused', 'bg:#444444 fg:#ffffff'),
            ('checkbox-list', 'fg:#ffffff'),
            ('checkbox-list.focused', 'bg:#444444 fg:#ffffff'),
            ('text-area', 'bg:#222222 fg:#ffffff'),
            ('text-area.focused', 'bg:#444444 fg:#ffffff'),
            ('radio-list.checked', 'fg:#00ff00'),
            ('checkbox-list.checked', 'fg:#00ff00'),
        ])

    def _setup_key_bindings(self):
        """Sets up key bindings for navigation and application exit."""
        @self.kb.add('c-c')
        def _(event):
            """Pressing Ctrl-C will exit the user interface."""
            event.app.exit()

        @self.kb.add('tab')
        def _(event):
            self._focus_next()

        @self.kb.add('s-tab')
        def _(event):
            self._focus_previous()

        @self.kb.add('down')
        def _(event):
            current_field_control = self.application.layout.current_window.content
            if isinstance(current_field_control, (RadioList, CheckboxList)):
                # Delegate to the widget's internal navigation
                current_field_control._handle_down(event)
            else:
                self._focus_next()

        @self.kb.add('up')
        def _(event):
            current_field_control = self.application.layout.current_window.content
            if isinstance(current_field_control, (RadioList, CheckboxList)):
                # Delegate to the widget's internal navigation
                current_field_control._handle_up(event)
            else:
                self._focus_previous()

        @self.kb.add('enter')
        def _(event):
            if self.application.layout.has_focus(self.submit_button):
                self._submit()
            else:
                self._focus_next()

    def _focus_next(self):
        """Moves focus to the next form field or the submit button."""
        self.focused_field_index = (self.focused_field_index + 1) % (len(self.fields) + 1) # +1 for submit button
        self._update_focus()

    def _focus_previous(self):
        """Moves focus to the previous form field or the submit button."""
        self.focused_field_index = (self.focused_field_index - 1 + len(self.fields) + 1) % (len(self.fields) + 1)
        self._update_focus()

    def _update_focus(self):
        """Updates the application's focus based on the current index."""
        if self.focused_field_index < len(self.fields):
            self.application.layout.focus(self.fields[self.focused_field_index].control)
        else:
            self.application.layout.focus(self.submit_button)

    def _submit(self, event=None):
        """Handles form submission, including validation and displaying results."""
        all_valid = True
        for field in self.fields:
            if not field.validate():
                all_valid = False

        if all_valid:
            data = {field.name: field.get_value() for field in self.fields}
            self.submit_message_control.text = f"Form submitted successfully! Data: {data}"
            # In a real application, you would process 'data' here (e.g., save to DB, send to API)
            # event.app.exit(result=data) # Optionally exit with data
        else:
            self.submit_message_control.text = "Please correct the errors in the form."
            # Find the first invalid field and focus it
            for i, field in enumerate(self.fields):
                if not field.is_valid:
                    self.focused_field_index = i
                    self._update_focus()
                    break

    def run(self):
        """Runs the prompt_toolkit application."""
        self.application.run()

if __name__ == "__main__":
    form = MultiFieldForm()
    form.run()
