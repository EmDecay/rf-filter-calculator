import re
from InquirerPy import inquirer
from InquirerPy.validator import Validator, EmptyInput, ValidationError


class EmailValidator(Validator):
    def validate(self, document):
        if not re.match(r"[^@]+@[^@]+\\.[^@]+", document.text):
            raise ValidationError(
                message="Please enter a valid email address",
                cursor_position=len(document.text),
            )

def main():
    print("Welcome to the InquirerPy Multi-Field Form Example!")
    print("-" * 50)

    # Text Input with EmptyInput validation
    name = inquirer.text(
        message="What is your full name?",
        validate=EmptyInput(message="Name cannot be empty"),
        invalid_message="Input cannot be empty.",
    ).execute()

    # Text Input with custom EmailValidator
    email = inquirer.text(
        message="What is your email address?",
        validate=EmailValidator(),
        invalid_message="Please enter a valid email address.",
    ).execute()

    # Select (single choice) with default value
    gender = inquirer.select(
        message="What is your gender?",
        choices=["Male", "Female", "Non-binary", "Prefer not to say"],
        default="Prefer not to say",
    ).execute()

    # Checkbox (multiple choice) with validation for minimum selections
    interests = inquirer.checkbox(
        message="What are your interests? (Select at least 2)",
        choices=["Programming", "Reading", "Sports", "Music", "Travel", "Cooking"],
        validate=lambda result: len(result) >= 2,
        invalid_message="Please select at least 2 interests.",
        instruction="(Press <space> to select, <enter> to finish)",
    ).execute()

    # Text Input for age with NumberValidator (InquirerPy has a built-in NumberValidator, but for demonstration, we can use a simple lambda)
    age = inquirer.text(
        message="How old are you?",
        validate=lambda result: result.isdigit() and int(result) > 0,
        invalid_message="Please enter a valid positive number for age.",
    ).execute()

    # Confirmation prompt
    confirm = inquirer.confirm(
        message="Do you want to submit your information?",
        default=True
    ).execute()

    print("-" * 50)
    if confirm:
        print("\nThank you for your submission! Here is your information:")
        print(f"Name: {name}")
        print(f"Email: {email}")
        print(f"Gender: {gender}")
        print(f"Interests: ", ".".join(interests))
        print(f"Age: {age}")
    else:
        print("\nSubmission cancelled.")


if __name__ == "__main__":
    main()
