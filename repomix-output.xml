from __future__ import annotations

import asyncio
from dataclasses import dataclass, field
from typing import Any

from textual import on, work
from textual.app import App, ComposeResult
from textual.containers import Center, Container, Horizontal, Vertical
from textual.screen import ModalScreen, Screen
from textual.widgets import (
    Button,
    ContentSwitcher,
    Footer,
    Header,
    Input,
    Label,
    LoadingIndicator,
    Static,
)

# --- Data Model ---

@dataclass
class FilterSpecs:
    name: str = ""
    frequency: float = 0.0
    units: str = "MHz"
    results: dict[str, Any] = field(default_factory=dict)

# --- Modal Screen (Returning Values) ---

class ExitModal(ModalScreen[bool]):
    """A modal that returns a boolean indicating if the user wants to exit."""
    
    def compose(self) -> ComposeResult:
        with Vertical(id="modal-container"):
            yield Label("Are you sure you want to cancel the wizard?")
            with Horizontal():
                yield Button("No", variant="primary", id="no")
                yield Button("Yes, Cancel", variant="error", id="yes")

    @on(Button.Pressed, "#yes")
    def handle_yes(self) -> None:
        self.dismiss(True)

    @on(Button.Pressed, "#no")
    def handle_no(self) -> None:
        self.dismiss(False)

    def action_cancel(self) -> None:
        """Handle Escape key inside modal."""
        self.dismiss(False)

# --- Wizard Steps (Using Static/ContentSwitcher) ---

class StepInput(Static):
    def compose(self) -> ComposeResult:
        yield Label("Enter Filter Name:", classes="label")
        yield Input(placeholder="e.g. My Lowpass", id="name-input")
        yield Label("Cutoff Frequency:", classes="label")
        yield Input(placeholder="e.g. 100", id="freq-input")
        yield Label("", id="error-msg", classes="error")

class StepCalculating(Static):
    def compose(self) -> ComposeResult:
        with Center():
            yield Label("Synthesizing Filter Components...")
            yield LoadingIndicator()

class StepResults(Static):
    def compose(self) -> ComposeResult:
        yield Label("Design Results:", classes="label")
        yield Static(id="results-content")

# --- Main App ---

class WizardApp(App):
    CSS = """
    #wizard-outer {
        align: center middle;
    }
    
    #wizard-inner {
        width: 60;
        height: auto;
        border: thick $primary;
        padding: 1 2;
        background: $surface;
    }

    .label {
        margin-top: 1;
        text-style: bold;
    }

    .error {
        color: $error;
        height: 1;
    }

    #nav-bar {
        margin-top: 1;
        height: 3;
        align: center middle;
    }

    #nav-bar Button {
        margin: 0 1;
    }

    #modal-container {
        width: 40;
        height: auto;
        padding: 1 2;
        background: $panel;
        border: thick $primary;
        align: center middle;
    }

    #modal-container Button {
        margin: 1 1 0 1;
    }

    LoadingIndicator {
        height: 3;
        margin-top: 1;
    }
    """

    BINDINGS = [
        ("escape", "request_cancel", "Cancel"),
    ]

    def __init__(self):
        super().__init__()
        self.specs = FilterSpecs()
        self.steps = ["input", "calculating", "results"]

    def compose(self) -> ComposeResult:
        yield Header()
        with Container(id="wizard-outer"):
            with Vertical(id="wizard-inner"):
                yield Label("Filter Design Wizard", id="title")
                
                with ContentSwitcher(initial="input"):
                    yield StepInput(id="input")
                    yield StepCalculating(id="calculating")
                    yield StepResults(id="results")
                
                with Horizontal(id="nav-bar"):
                    yield Button("Back", id="btn-back", disabled=True)
                    yield Button("Next", variant="primary", id="btn-next")
                    yield Button("Close", variant="success", id="btn-close", display=False)
        yield Footer()

    # --- Navigation Logic ---

    @on(Button.Pressed, "#btn-next")
    def action_next(self) -> None:
        current = self.query_one(ContentSwitcher).current
        
        if current == "input":
            if self.validate_input():
                self.goto_calculating()
        
    def validate_input(self) -> bool:
        name = self.query_one("#name-input", Input).value
        freq = self.query_one("#freq-input", Input).value
        
        if not name or not freq:
            self.query_one("#error-msg", Label).update("All fields are required!")
            return False
        
        try:
            self.specs.name = name
            self.specs.frequency = float(freq)
            return True
        except ValueError:
            self.query_one("#error-msg", Label).update("Frequency must be a number!")
            return False

    def goto_calculating(self) -> None:
        self.query_one(ContentSwitcher).current = "calculating"
        self.query_one("#btn-next").disabled = True
        self.query_one("#btn-back").disabled = True
        self.run_calculation()

    @work(exclusive=True)
    async def run_calculation(self) -> None:
        """Simulate a long-running calculation."""
        await asyncio.sleep(2)  # Simulate work
        
        # 'Calculate' some dummy components
        self.specs.results = {
            "L1": "4.7 nH",
            "C1": "1.2 pF",
            "L2": "10 nH"
        }
        
        # Switch to results
        self.call_from_thread(self.show_results)

    def show_results(self) -> None:
        self.query_one(ContentSwitcher).current = "results"
        
        res_str = f"Filter Name: [cyan]{self.specs.name}[/]\n"
        res_str += f"Frequency: [cyan]{self.specs.frequency} MHz[/]\n\n"
        res_str += "Components:\n"
        for k, v in self.specs.results.items():
            res_str += f"- {k}: [bold]{v}[/]\n"
            
        self.query_one("#results-content", Static).update(res_str)
        
        # UI Updates
        self.query_one("#btn-next").display = False
        self.query_one("#btn-close").display = True
        self.query_one("#btn-back").display = True

    @on(Button.Pressed, "#btn-back")
    def action_back(self) -> None:
        current = self.query_one(ContentSwitcher).current
        if current == "results":
            self.query_one(ContentSwitcher).current = "input"
            self.query_one("#btn-next").display = True
            self.query_one("#btn-next").disabled = False
            self.query_one("#btn-close").display = False
            self.query_one("#btn-back").disabled = True

    @on(Button.Pressed, "#btn-close")
    def action_close(self) -> None:
        self.exit()

    # --- Keyboard Shortcuts ---

    @on(Input.Submitted)
    def handle_enter(self) -> None:
        """Allow Enter to advance the wizard."""
        self.action_next()

    def action_request_cancel(self) -> None:
        """Handle Escape key by showing a modal."""
        self.push_screen(ExitModal(), self.handle_exit_confirm)

    def handle_exit_confirm(self, should_exit: bool) -> None:
        if should_exit:
            self.exit()

if __name__ == "__main__":
    WizardApp().run()
