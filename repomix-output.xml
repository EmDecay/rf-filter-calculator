from __future__ import annotations

from typing import Any
from textual import on
from textual.app import App, ComposeResult
from textual.containers import Container, Horizontal, Vertical, Grid
from textual.message import Message
from textual.reactive import reactive
from textual.screen import Screen
from textual.validation import Function, Number, ValidationResult, Validator
from textual.widgets import (
    Button,
    Checkbox,
    Footer,
    Header,
    Input,
    Label,
    RadioButton,
    RadioSet,
    Select,
    Static,
    ContentSwitcher,
)

# --- Custom Validator ---

class NameValidator(Validator):
    def validate(self, value: str) -> ValidationResult:
        if len(value.strip()) < 2:
            return self.failure("Name must be at least 2 characters.")
        if not value.replace(" ", "").isalpha():
            return self.failure("Name must contain only letters.")
        return self.success()

# --- CSS Styling ---

CSS = """
Screen {
    align: center middle;
}

#wizard-container {
    width: 60;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

.step-title {
    text-align: center;
    width: 100%;
    text-style: bold;
    margin-bottom: 1;
    color: $accent;
}

.field-group {
    margin-bottom: 1;
    height: auto;
}

.field-label {
    width: 100%;
    text-style: italic;
    color: $text-muted;
}

.error-message {
    color: $error;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#navigation {
    margin-top: 1;
    height: 3;
    align: center middle;
}

#navigation Button {
    margin: 0 1;
}

ContentSwitcher {
    height: auto;
    min-height: 12;
}

/* Reactive binding preview style */
#live-preview {
    background: $boost;
    padding: 1;
    margin-top: 1;
    border: dashed $secondary;
}

/* Custom Theme override example */
.dark-mode {
    background: #121212;
}
"""

# --- App State Class ---
# Best practice: Centralized data storage for the wizard
class WizardData:
    def __init__(self):
        self.name = ""
        self.age = ""
        self.filter_type = "lowpass"
        self.unit = "MHz"
        self.notifications = True

# --- Wizard Steps ---

class StepOne(Static):
    """Basic Information Step."""
    def compose(self) -> ComposeResult:
        with Vertical(classes="field-group"):
            yield Label("What is your name?", classes="field-label")
            yield Input(
                placeholder="Enter your name...",
                validators=[NameValidator()],
                id="name-input"
            )
            yield Label("", id="name-error", classes="error-message")
        
        with Vertical(classes="field-group"):
            yield Label("Age", classes="field-label")
            yield Input(
                placeholder="Enter your age...",
                validators=[Number(minimum=1, maximum=120)],
                id="age-input"
            )
            yield Label("", id="age-error", classes="error-message")

class StepTwo(Static):
    """Preferences Step."""
    def compose(self) -> ComposeResult:
        with Vertical(classes="field-group"):
            yield Label("Filter Type", classes="field-label")
            with RadioSet(id="filter-type"):
                yield RadioButton("Lowpass", value=True, id="lp")
                yield RadioButton("Highpass", id="hp")
                yield RadioButton("Bandpass", id="bp")
        
        with Vertical(classes="field-group"):
            yield Label("Frequency Unit", classes="field-label")
            yield Select(
                [("Hertz", "Hz"), ("Kilohertz", "kHz"), ("Megahertz", "MHz")],
                value="MHz",
                id="unit-select"
            )
        
        with Horizontal(classes="field-group"):
            yield Checkbox("Enable notifications", value=True, id="notify-check")

class StepThree(Static):
    """Summary and Reactive Preview Step."""
    
    # Reactive property for data binding demonstration
    preview_text = reactive("Waiting for input...")

    def compose(self) -> ComposeResult:
        yield Label("Review your details:", classes="field-label")
        yield Static(id="summary-content")
        
        yield Label("Live Status Preview:", classes="field-label")
        yield Static(id="live-preview")

    def watch_preview_text(self, value: str) -> None:
        """Called when preview_text changes."""
        try:
            self.query_one("#live-preview", Static).update(value)
        except:
            pass

# --- Main App ---

class WizardApp(App):
    CSS = CSS
    TITLE = "Modern Textual Wizard Demo"
    BINDINGS = [
        ("d", "toggle_dark", "Toggle Dark Mode"),
        ("q", "quit", "Quit"),
    ]

    # Tracks current step
    current_step_index = reactive(0)
    steps = ["step-1", "step-2", "step-3"]

    def __init__(self):
        super().__init__()
        self.data = WizardData()

    def compose(self) -> ComposeResult:
        yield Header()
        with Container(id="wizard-container"):
            yield Label("Step 1 of 3", id="step-indicator", classes="step-title")
            
            with ContentSwitcher(initial="step-1"):
                yield StepOne(id="step-1")
                yield StepTwo(id="step-2")
                yield StepThree(id="step-3")
            
            with Horizontal(id="navigation"):
                yield Button("Back", id="back-btn", variant="default")
                yield Button("Next", id="next-btn", variant="primary")
                yield Button("Submit", id="submit-btn", variant="success", classes="hidden")
        yield Footer()

    # --- Reactive Logic ---

    def watch_current_step_index(self, index: int) -> None:
        """Update UI when step changes."""
        # Update switcher
        self.query_one(ContentSwitcher).current = self.steps[index]
        
        # Update title
        self.query_one("#step-indicator", Label).update(f"Step {index + 1} of 3")
        
        # Button visibility logic
        self.query_one("#back-btn").disabled = (index == 0)
        
        is_last = (index == len(self.steps) - 1)
        self.query_one("#next-btn").display = not is_last
        self.query_one("#submit-btn").display = is_last

        if is_last:
            self.update_summary()

    def update_summary(self) -> None:
        """Populate the summary screen and demonstrate reactive binding."""
        summary = (
            f"Name: [bold]{self.data.name}[/]\n"
            f"Age: [bold]{self.data.age}[/]\n"
            f"Filter: [bold]{self.data.filter_type}[/]\n"
            f"Unit: [bold]{self.data.unit}[/]\n"
            f"Notifications: [bold]{'Yes' if self.data.notifications else 'No'}[/]]"
        )
        self.query_one("#summary-content", Static).update(summary)
        
        # Setting reactive property
        step3 = self.query_one(StepThree)
        step3.preview_text = f"Ready to calculate {self.data.filter_type} filter in {self.data.unit}!"

    # --- Event Handlers (Using @on decorator - Best Practice) ---

    @on(Button.Pressed, "#next-btn")
    def handle_next(self) -> None:
        if self.validate_current_step():
            if self.current_step_index < len(self.steps) - 1:
                self.current_step_index += 1

    @on(Button.Pressed, "#back-btn")
    def handle_back(self) -> None:
        if self.current_step_index > 0:
            self.current_step_index -= 1

    @on(Button.Pressed, "#submit-btn")
    def handle_submit(self) -> None:
        self.notify("Form Submitted Successfully!")
        # In a real app, you'd process self.data here
        self.exit(result=vars(self.data))

    @on(Input.Changed)
    def handle_input_change(self, event: Input.Changed) -> None:
        """Save data as user types."""
        if event.input.id == "name-input":
            self.data.name = event.value
        elif event.input.id == "age-input":
            self.data.age = event.value

    @on(Input.Submitted)
    def handle_input_submitted(self) -> None:
        """Allow Enter key to go to next step."""
        self.handle_next()

    @on(RadioSet.Changed, "#filter-type")
    def handle_filter_changed(self, event: RadioSet.Changed) -> None:
        self.data.filter_type = str(event.pressed_button.label).lower()

    @on(Select.Changed, "#unit-select")
    def handle_unit_changed(self, event: Select.Changed) -> None:
        self.data.unit = str(event.value)

    @on(Checkbox.Changed, "#notify-check")
    def handle_notify_changed(self, event: Checkbox.Changed) -> None:
        self.data.notifications = event.value

    # --- Validation Logic ---

    def validate_current_step(self) -> bool:
        """Validates widgets in the current step and shows errors."""
        if self.current_step_index == 0:
            name_input = self.query_one("#name-input", Input)
            age_input = self.query_one("#age-input", Input)
            
            v1 = name_input.validate()
            v2 = age_input.validate()
            
            # Show/Hide error messages
            self.query_one("#name-error", Label).update("" if v1.is_valid else v1.failure_descriptions[0])
            self.query_one("#age-error", Label).update("" if v2.is_valid else v2.failure_descriptions[0])
            
            return v1.is_valid and v2.is_valid
        
        return True

    def action_toggle_dark(self) -> None:
        self.dark = not self.dark

if __name__ == "__main__":
    app = WizardApp()
    app.run()
</file>

