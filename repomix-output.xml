import urwid
import re

class MyForm:
    def __init__(self):
        self.name_edit = urwid.Edit("Name: ", edit_text="")
        self.email_edit = urwid.Edit("Email: ", edit_text="")

        # Radio buttons for contact method
        self.contact_method_group = []
        self.email_radio = urwid.RadioButton(self.contact_method_group, "Email", state=True)
        self.phone_radio = urwid.RadioButton(self.contact_method_group, "Phone")
        self.mail_radio = urwid.RadioButton(self.contact_method_group, "Mail")

        self.newsletter_checkbox = urwid.CheckBox("Subscribe to Newsletter", state=False)

        self.submit_button = urwid.Button("Submit")
        urwid.connect_signal(self.submit_button, 'click', self.on_submit)

        self.status_text = urwid.Text("")

        # Assemble the form widgets
        form_widgets = [
            urwid.Text("Urwid Multi-Field Form Example", align='center'),
            urwid.Divider(),
            urwid.AttrMap(self.name_edit, 'edit_field', 'edit_field_focus'),
            urwid.AttrMap(self.email_edit, 'edit_field', 'edit_field_focus'),
            urwid.Text("\nPreferred Contact Method:"),
            urwid.Columns([
                ('fixed', 10, urwid.AttrMap(self.email_radio, 'radio_button', 'radio_button_focus')),
                ('fixed', 10, urwid.AttrMap(self.phone_radio, 'radio_button', 'radio_button_focus')),
                ('fixed', 10, urwid.AttrMap(self.mail_radio, 'radio_button', 'radio_button_focus')),
            ]),
            urwid.AttrMap(self.newsletter_checkbox, 'checkbox', 'checkbox_focus'),
            urwid.Divider(),
            urwid.AttrMap(self.submit_button, 'button', 'button_focus'),
            urwid.Divider(),
            self.status_text,
        ]

        self.form_pile = urwid.Pile(form_widgets)
        self.form_filler = urwid.Filler(self.form_pile, 'top')
        self.view = urwid.Frame(body=self.form_filler)

    def validate_form(self):
        errors = []
        name = self.name_edit.edit_text.strip()
        email = self.email_edit.edit_text.strip()

        if not name:
            errors.append("Name cannot be empty.")
        
        if not email:
            errors.append("Email cannot be empty.")
        elif not re.match(r"[^@]+@[^@]+\.[^@]+", email):
            errors.append("Invalid email format.")

        # Check if a contact method is selected (at least one radio button is true)
        if not any(rb.state for rb in self.contact_method_group):
            errors.append("Please select a preferred contact method.")

        return errors

    def on_submit(self, button):
        errors = self.validate_form()
        if errors:
            self.status_text.set_text(('error', "\n".join(errors)))
        else:
            name = self.name_edit.edit_text
            email = self.email_edit.edit_text
            contact_method = next(rb.label for rb in self.contact_method_group if rb.state)
            newsletter = "Yes" if self.newsletter_checkbox.state else "No"

            result_message = (
                f"Form Submitted Successfully!\n"
                f"Name: {name}\n"
                f"Email: {email}\n"
                f"Contact Method: {contact_method}\n"
                f"Newsletter: {newsletter}"
            )
            self.status_text.set_text(('success', result_message))

    def unhandled_input(self, key):
        if key in ('q', 'Q', 'esc'):
            raise urwid.ExitMainLoop()

    def main(self):
        palette = [
            ('body', 'black', 'light gray'),
            ('header', 'white', 'dark blue', 'bold'),
            ('footer', 'white', 'dark blue', 'bold'),
            ('edit_field', 'black', 'white'),
            ('edit_field_focus', 'white', 'dark blue', 'bold'),
            ('radio_button', 'black', 'light gray'),
            ('radio_button_focus', 'white', 'dark blue', 'bold'),
            ('checkbox', 'black', 'light gray'),
            ('checkbox_focus', 'white', 'dark blue', 'bold'),
            ('button', 'white', 'dark green'),
            ('button_focus', 'white', 'dark red', 'bold'),
            ('error', 'white', 'dark red'),
            ('success', 'white', 'dark green'),
        ]
        loop = urwid.MainLoop(self.view, palette, unhandled_input=self.unhandled_input)
        loop.run()

if __name__ == '__main__':
    form = MyForm()
    form.main()
